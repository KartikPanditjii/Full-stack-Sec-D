{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PEP8: Format Code with Black",
      "type": "shell",
      "command": "python -m black . --line-length 88",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "PEP8: Run Flake8 Linter",
      "type": "shell",
      "command": "python -m flake8 . --max-line-length=88 --exclude=.venv",
      "problemMatcher": "$flake8",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Django: Run Server",
      "type": "shell",
      "command": "python manage.py runserver",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Django: Apply Migrations",
      "type": "shell",
      "command": "python manage.py migrate",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Deployment: Run Automated Check",
      "type": "shell",
      "command": "python deploy_check.py",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
